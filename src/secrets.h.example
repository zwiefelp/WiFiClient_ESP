#ifndef SECRETS_H
#define SECRETS_H

// Vorlage fuer die Zugangsdaten.
// Kopieren nach secrets.h und mit den eigenen Werten fuellen:
//   cp secrets.h.example secrets.h
// secrets.h ist in .gitignore ausgeschlossen und wird NICHT versioniert.

#define SECRET_WIFI_SSID     "DEIN_WLAN_SSID"
#define SECRET_WIFI_PASSWORD "DEIN_WLAN_PASSWORT"
#define SECRET_MQTT_SERVER   "192.168.1.1"

// OTA (drahtloses Flashen ueber WLAN)
// Hostname ergibt den mDNS-Namen <Hostname>.local (z.B. esp-display.local)
#define SECRET_OTA_HOSTNAME  "esp-display"
// OTA-Passwort: frei waehlen, schuetzt vor fremden Uploads im Netz
#define SECRET_OTA_PASSWORD  "DEIN_OTA_PASSWORT"

#endif // SECRETS_H
